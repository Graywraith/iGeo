---
import { getStore } from '@netlify/blobs';
import Layout from '../../../layouts/Layout.astro';
import { extractEmailBody } from '../../../utils/supportEmail';

export const prerender = false;

type StoredSupportEmail = {
    category?: string;
    event?: {
        created_at?: string;
        data?: {
            attachments?: unknown[];
            bcc?: string[];
            cc?: string[];
            created_at?: string;
            email_id?: string;
            from?: string;
            message_id?: string;
            to?: string[];
            subject?: string;
        };
        type?: string;
    };
    receivedEmail?: any;
};

const key = Astro.params.key;
if (!key) {
    return new Response('Bad Request', { status: 400 });
}

const store = getStore({ name: 'support-emails', consistency: 'strong' });
const blob = (await store.get(key, { type: 'json' })) as StoredSupportEmail | null;

if (!blob) {
    return new Response('Not Found', { status: 404 });
}

const subject = blob?.event?.data?.subject ?? blob?.receivedEmail?.subject ?? '(no subject)';
const from = blob?.event?.data?.from ?? blob?.receivedEmail?.from ?? '(unknown sender)';
const to = blob?.event?.data?.to ?? blob?.receivedEmail?.to;
const createdAt = blob?.event?.data?.created_at ?? blob?.event?.created_at ?? '';
const category = blob?.category ?? 'unknown';

const { text, html } = extractEmailBody(blob?.receivedEmail);
const attachments = blob?.receivedEmail?.attachments ?? blob?.event?.data?.attachments ?? [];
---

<Layout title={`Support Email: ${subject}`} noindex>
    <section class="space-y-6">
        <a class="btn" href="/admin/inbox">← Back to inbox</a>

        <header class="space-y-2">
            <h1 class="break-words">{subject}</h1>
            <div class="text-sm text-gray-300 space-y-1">
                <div><span class="text-gray-400">From:</span> {from}</div>
                <div><span class="text-gray-400">To:</span> {Array.isArray(to) ? to.join(', ') : '(unknown recipients)'}</div>
                <div class="flex flex-wrap gap-x-4">
                    <div><span class="text-gray-400">Category:</span> {category}</div>
                    {
                        createdAt && (
                            <div>
                                <span class="text-gray-400">Received:</span> {createdAt}
                            </div>
                        )
                    }
                </div>
            </div>
        </header>

        <div class="grid gap-6">
            <div class="rounded-lg bg-black/20 p-4 ring-1 ring-white/10">
                <h2 class="text-xl font-semibold">Text</h2>
                {text ? <pre class="mt-3 whitespace-pre-wrap">{text}</pre> : <p class="mt-3 text-gray-400">No text body.</p>}
            </div>

            <div class="rounded-lg bg-black/20 p-4 ring-1 ring-white/10">
                <h2 class="text-xl font-semibold">HTML</h2>
                {
                    html ? (
                        <div class="mt-3 space-y-3">
                            <div class="text-sm text-gray-300">Rendered preview (sandboxed):</div>
                            <iframe
                                class="w-full rounded-md bg-white"
                                title="Email HTML preview"
                                sandbox="allow-popups allow-popups-to-escape-sandbox"
                                referrerpolicy="no-referrer"
                                srcdoc={html}
                                style="min-height: 420px;"
                            />
                            <details>
                                <summary class="cursor-pointer text-sm font-semibold text-gray-200">View HTML source</summary>
                                <pre class="mt-3 whitespace-pre-wrap">{html}</pre>
                            </details>
                        </div>
                    ) : (
                        <p class="mt-3 text-gray-400">No HTML body.</p>
                    )
                }
            </div>

            <div class="rounded-lg bg-black/20 p-4 ring-1 ring-white/10">
                <h2 class="text-xl font-semibold">Attachments</h2>
                {
                    Array.isArray(attachments) && attachments.length > 0 ? (
                        <pre class="mt-3 whitespace-pre-wrap">{JSON.stringify(attachments, null, 2)}</pre>
                    ) : (
                        <p class="mt-3 text-gray-400">No attachments.</p>
                    )
                }
            </div>

            <details class="rounded-lg bg-black/20 p-4 ring-1 ring-white/10">
                <summary class="cursor-pointer text-xl font-semibold">Raw payload</summary>
                <pre class="mt-3 whitespace-pre-wrap">{JSON.stringify(blob, null, 2)}</pre>
            </details>
        </div>
    </section>
</Layout>
